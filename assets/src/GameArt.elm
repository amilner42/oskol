module GameArt exposing
    ( Rect
    , accent
    , art
    , frameCount
    , framesFor
    , motif
    , rects
    )

{-| Per-game presentation for the library: a notebook-palette accent and a
small piece of pixel art drawn from a character grid. A direct port of
`OskolWeb.GameArt` (which the SPA replaced) — same grids, same palette, same
markup and class names.

A game's art is a list of frames. They are stacked into a reel and cycled by
one CSS `steps()` animation on a single transform: no JavaScript, nothing to
schedule on a phone. `prefers-reduced-motion` drops the animation, which
leaves the first frame showing.

The grid is decomposed into as few `<rect>`s as it can be: equal neighbours
merge along a row, then identical runs merge down the rows, so a solid
background costs one rect instead of a thousand. The Elixir version did this
at compile time; here it is `rects`, memoised per art node by `Html.Lazy`.

-}

import Html exposing (Html)
import Html.Attributes exposing (attribute, class)
import Html.Lazy
import Set exposing (Set)
import Svg
import Svg.Attributes as SvgAttr


{-| How long one frame of a game's art is held.
-}
frameMs : Int
frameMs =
    800


{-| A rectangle covering a run of equal cells.
-}
type alias Rect =
    { x : Int
    , y : Int
    , w : Int
    , h : Int
    , color : String
    }



