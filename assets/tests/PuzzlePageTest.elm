                    , \_ -> rendered tapped |> Query.find [ id "pz-never-yes" ] |> Query.hasNot [ class "is-idle" ]
                    , \_ -> rendered tapped |> Query.find [ id "pz-outcome-never" ] |> Query.has [ class "is-pending" ]

