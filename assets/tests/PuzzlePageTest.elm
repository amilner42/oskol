                    [ \_ -> from "/practice/openings" |> Query.has [ attribute (Html.Attributes.href "/practice/openings"), text "Back to openings →" ]
                    , \_ -> from "/puzzles" |> Query.has [ attribute (Html.Attributes.href "/puzzles"), text "Back to puzzles →" ]
                    ]
                    ()
        , wayOn
        ]


