-- FIXTURES


fixture : List ( String, String ) -> String -> String
fixture all name =
    all |> List.filter (\( n, _ ) -> n == name) |> List.head |> Maybe.map Tuple.second |> Maybe.withDefault ""


question : String -> String
question =
    fixture PuzzleApiFixtures.all


reveal : String -> String
reveal =
    fixture PuzzleRevealFixtures.all


{-| A reveal with a schedule spliced in where the guest's `null` was: what
the same endpoint answers an account.
-}
revealWith : String -> String -> String
revealWith name scheduleName =
    String.replace "\"schedule\":null" ("\"schedule\":" ++ reveal scheduleName) (reveal name)


decodeReveal : String -> Result String Puzzle.Reveal
decodeReveal body =
    Api.parseBody Puzzle.revealDecoder body |> Result.mapError Api.errorMessage


{-| A page with the question in and the key minted.
-}
page : { hasNext : Bool } -> String -> Page.Model
page config name =
    let
        ( model, _ ) =
            Page.init Session.empty { id = "fix", hasNext = config.hasNext, inRun = config.hasNext, progress = Nothing, tier = Nothing, deck = Nothing, today = Nothing, origin = "http://oskol.test", share = Nothing }

        loaded =
            case D.decodeString Puzzle.decoder (question name) of
                Ok p ->
                    GotPuzzle (Ok p)

                Err e ->
                    GotPuzzle (Err (Api.DecodeError (D.errorToString e)))
    in
    model |> step loaded |> step (GotKey "key-0123")


step : Msg -> Page.Model -> Page.Model
step msg model =
    let
        ( next_, _, _ ) =
            Page.update msg model
    in
    next_


out : Msg -> Page.Model -> Page.Out
out msg model =
    let
        ( _, _, o ) =
            Page.update msg model
    in
    o


{-| A schedule as the wire carries one: where the mistake stood, where
it stands now, and whether this answer is the one that patched it.
-}
scheduleJson : Int -> Int -> Bool -> String
scheduleJson before after patched =
    """{"level_before":"""
        ++ String.fromInt before
        ++ ""","level_after":"""
        ++ String.fromInt after
        ++ ""","due":1800000000000,"amendable":true,"self_grade":false,"patched":"""
        ++ (if patched then
                "true"

            else
                "false"
           )
        ++ "}"


{-| A page at the reveal, with this schedule spliced into it.
-}
withReveal : String -> String -> Page.Model
withReveal name stands =
    revealed
        (String.replace "\"schedule\":null" ("\"schedule\":" ++ stands) (reveal name))
        (page { hasNext = False } "move")


revealed : String -> Page.Model -> Page.Model
revealed body model =
    case decodeReveal body of
        Ok r ->
            step (GotReveal (Ok r)) model

        Err e ->
            step (GotReveal (Err (Api.DecodeError e))) model


rendered : Page.Model -> Query.Single Msg
rendered model =
    Page.view model |> Query.fromHtml


{-| The tree of the page's question, and a path root -> terminal through
it: the first complete turn the tree offers, as a tap sequence.
-}
aTurn : Page.Model -> ( List String, List Puzzle.Child )
aTurn model =
    case model.puzzle of
        Page.Loaded p ->
            case p.tree of
                Just tree ->
                    let
                        walk id path steps =
                            case Dict.get id tree.nodes of
                                Just node ->
                                    case node.children of
                                        [] ->
                                            ( List.reverse path, List.reverse steps )

                                        child :: _ ->
                                            walk child.node (child.node :: path) (child :: steps)

                                Nothing ->
                                    ( List.reverse path, List.reverse steps )
                    in
                    walk tree.root [] []

                Nothing ->
                    ( [], [] )

        _ ->
            ( [], [] )


has : List Test.Html.Selector.Selector -> Query.Single msg -> Expect.Expectation
has selectors q =
    q |> Query.findAll selectors |> Query.count (Expect.atLeast 1)


hasNot : List Test.Html.Selector.Selector -> Query.Single msg -> Expect.Expectation
hasNot selectors q =
    q |> Query.findAll selectors |> Query.count (Expect.equal 0)



-- DECODING


decoding : Test
decoding =
    describe "every reveal the server sends decodes"
        ((PuzzleRevealFixtures.all
            |> List.filter (\( name, _ ) -> not (String.startsWith "schedule" name))
            |> List.map
                (\( name, body ) ->
                    test name <|
                        \_ ->
                            case decodeReveal body of
                                Ok r ->
                                    Expect.all
                                        [ \_ ->
                                            -- named for its verdict, or for a
                                            -- verdict's case: a dubious answer
                                            -- is a miss, a coin flip right
                                            Puzzle.verdictName r.verdict
                                                |> Expect.equal
                                                    (case String.split "_" name |> List.drop 1 |> String.join "_" of
                                                        "dubious" ->
                                                            "fail"

                                                        "close" ->
                                                            "pass"

                                                        "close_yes" ->
                                                            "pass"

                                                        "close_no" ->
                                                            "pass"

                                                        verdict ->
                                                            verdict
                                                    )
                                        , \_ ->
                                            [ "best", "ok", "doubtful", "bad", "very_bad", "unknown" ]
                                                |> List.member r.band
                                                |> Expect.equal True
                                        , \_ -> (r.band == "unknown") |> Expect.equal (r.cost == Nothing)
                                        , \_ ->
                                            -- the answer is either a play or a cube, never both, never neither
                                            (r.best /= Nothing) |> Expect.notEqual (r.cube /= Nothing)
                                        , \_ -> r.schedule |> Expect.equal Nothing
                                        ]
                                        ()

                                Err e ->
                                    Expect.fail e
                )
         )
            ++ [ test "every schedule shape decodes" <|
                    \_ ->
                        [ "schedule_amendable", "schedule_self_grade", "schedule_settled" ]
                            |> List.map (\n -> D.decodeString Puzzle.scheduleDecoder (reveal n) |> Result.map (\s -> ( s.amendable, s.selfGrade )))
                            |> Expect.equal [ Ok ( True, False ), Ok ( False, True ), Ok ( False, False ) ]
               , test "a verdict the page does not know fails the answer rather than becoming unknown" <|
                    \_ ->
                        decodeReveal (String.replace "\"verdict\":\"pass\"" "\"verdict\":\"meh\"" (reveal "move_pass"))
                            |> Expect.err
               ]
        )



-- STAGING


staging : Test
staging =
    describe "a move staged via the board"
        [ test "the question renders the board and asks in the server's words" <|
            \_ ->
                rendered (page { hasNext = False } "move")
                    |> Expect.all
                        [ has [ id "pz-board" ]
                        , \q -> q |> Query.find [ id "pz-prompt" ] |> Query.has [ text "White to play 6-4. What's your play?" ]
                        , \q -> q |> Query.find [ id "pz-score" ] |> Query.has [ text "White 3 away, Black 5 away · cube centered" ]
                        , hasNot [ id "pz-reveal" ]
                        , hasNot [ id "pz-share" ]
                        , hasNot [ id "pz-analysis" ]
                        ]
        , test "one point each way is a single game; marked Crawford it is a match; no score is unlimited" <|
            \_ ->
                let
                    scored mover opp crawford =
                        question "move"
                            |> String.replace "\"mover_away\":3,\"opponent_away\":5" ("\"mover_away\":" ++ mover ++ ",\"opponent_away\":" ++ opp)
                            |> String.replace "\"crawford\":false" ("\"crawford\":" ++ crawford)

                    scoreLineOf json =
                        case D.decodeString Puzzle.decoder json of
                            Ok p ->
                                let
                                    ( fresh, _ ) =
                                        Page.init Session.empty { id = "fix", hasNext = False, inRun = False, progress = Nothing, tier = Nothing, deck = Nothing, today = Nothing, origin = "", share = Nothing }
                                in
                                rendered (step (GotPuzzle (Ok p)) fresh) |> Query.find [ id "pz-score" ]

                            Err e ->
                                Query.fromHtml (Html.text (D.errorToString e))
                in
                Expect.all
                    [ \_ -> scoreLineOf (scored "1" "1" "false") |> Query.has [ text "Single game · cube centered" ]
                    , \_ -> scoreLineOf (scored "1" "1" "true") |> Query.has [ text "White 1 away, Black 1 away · Crawford · cube centered" ]
                    , \_ -> scoreLineOf (String.replace "\"score\":{\"mover_away\":3,\"opponent_away\":5}" "\"score\":null" (question "move")) |> Query.has [ text "Unlimited · cube centered" ]
                    ]
                    ()
        , test "a tap walks to a child and UNDO walks back" <|
            \_ ->
                let
                    model =
                        page { hasNext = False } "move"

                    ( path, _ ) =
                        aTurn model

                    first =
                        List.take 1 path

                    stepped =
                        step (BoardOut (Puzzle.Stepped first)) model
                in
                Expect.all
                    [ \_ -> stepped.path |> Expect.equal first
                    , \_ -> rendered stepped |> has [ id "bg-action-undo" ]
                    , \_ -> (step (BoardOut Puzzle.Undo) stepped).path |> Expect.equal []
                    ]
                    ()
        , test "a step to a node a lazy tree does not hold yet is fetched, and lands in the tree" <|
            \_ ->
                let
                    model =
                        page { hasNext = False } "move"

                    ( path, _ ) =
                        aTurn model

                    lazy =
                        { model
                            | puzzle =
                                case model.puzzle of
                                    Page.Loaded p ->
                                        Page.Loaded
                                            { p
                                                | tree =
                                                    p.tree
                                                        |> Maybe.map
                                                            (\t ->
                                                                { t
                                                                    | lazy = True
                                                                    , nodes = List.foldl Dict.remove t.nodes path
                                                                }
                                                            )
                                            }

                                    other ->
                                        other
                        }

                    first =
                        List.head path |> Maybe.withDefault ""

                    node =
                        case model.puzzle of
                            Page.Loaded p ->
                                p.tree |> Maybe.andThen (\t -> Dict.get first t.nodes)

                            _ ->
                                Nothing

                    stepped =
                        step (BoardOut (Puzzle.Stepped [ first ])) lazy

                    landed =
                        case node of
                            Just n ->
                                step (GotNode first (Ok n)) stepped

                            Nothing ->
                                stepped
                in
                Expect.all
                    [ \_ -> stepped.fetching |> Expect.equal [ first ]
                    , \_ -> stepped.path |> Expect.equal [ first ]
                    , \_ -> landed.fetching |> Expect.equal []
                    , \_ ->
                        (case landed.puzzle of
                            Page.Loaded p ->
                                p.tree |> Maybe.map (\t -> Dict.member first t.nodes)

                            _ ->
                                Nothing
                        )
                            |> Expect.equal (Just True)
                    ]
                    ()
        ]



-- POSTING


posting : Test
posting =
    describe "PLAY posts the right body"
        [ test "the moves of the path walked, in order, with the page's key" <|
            \_ ->
                let
                    model =
                        page { hasNext = False } "move"

                    ( path, steps ) =
                        aTurn model

                    walked =
                        step (BoardOut (Puzzle.Stepped path)) model

                    expected =
                        E.object
                            [ ( "moves"
                              , E.list (\c -> E.object [ ( "from", E.string c.from ), ( "to", E.string c.to ), ( "die", E.int c.die ) ]) steps
                              )
                            , ( "key", E.string "key-0123" )
                            ]
                in
                Expect.all
                    [ \_ -> List.length steps |> Expect.atLeast 1
                    , \_ -> Page.attemptBody walked |> Maybe.map (E.encode 0) |> Expect.equal (Just (E.encode 0 expected))
                    , \_ -> (step (BoardOut Puzzle.Play) walked).attempt |> Expect.equal Sending
                    ]
                    ()
        , test "half a turn is not an attempt" <|
            \_ ->
                let
                    model =
                        page { hasNext = False } "move"

                    ( path, _ ) =
                        aTurn model

                    half =
                        step (BoardOut (Puzzle.Stepped (List.take 1 path))) model
                in
                Expect.all
                    [ \_ -> List.length path |> Expect.atLeast 2
                    , \_ -> Page.attemptBody half |> Expect.equal Nothing
                    , \_ -> (step (BoardOut Puzzle.Play) half).attempt |> Expect.equal NotYet
                    ]
                    ()
        , test "PLAY before the key is minted waits for it, then goes" <|
            \_ ->
                let
                    ( fresh, _ ) =
                        Page.init Session.empty { id = "fix", hasNext = False, inRun = False, progress = Nothing, tier = Nothing, deck = Nothing, today = Nothing, origin = "", share = Nothing }

                    model =
                        case D.decodeString Puzzle.decoder (question "move") of
                            Ok p ->
                                step (GotPuzzle (Ok p)) fresh

                            Err _ ->
                                fresh

                    ( path, _ ) =
                        aTurn model

                    pressed =
                        model |> step (BoardOut (Puzzle.Stepped path)) |> step (BoardOut Puzzle.Play)
                in
                Expect.all
                    [ \_ -> pressed.attempt |> Expect.equal NotYet
                    , \_ -> pressed.playWhenKeyed |> Expect.equal True
                    , \_ -> (step (GotKey "k") pressed).attempt |> Expect.equal Sending
                    ]
                    ()
        , test "a refused attempt is a sentence, and the board stays" <|
            \_ ->
                let
                    model =
                        page { hasNext = False } "move"

                    ( path, _ ) =
                        aTurn model

                    refused =
                        model
                            |> step (BoardOut (Puzzle.Stepped path))
                            |> step (GotReveal (Err (Api.ApiError { code = "validation_failed", message = "That is not a legal way to play the roll" })))
                in
                Expect.all
                    [ \_ -> refused.attempt |> Expect.equal (Refused "That is not a legal way to play the roll")
                    , \_ -> rendered refused |> Query.find [ id "pz-refused" ] |> Query.has [ text "That is not a legal way to play the roll" ]
                    , \_ -> rendered refused |> has [ id "bg-action-play" ]
                    , \_ -> (step (BoardOut Puzzle.Undo) refused).path |> Expect.equal (List.take (List.length path - 1) path)
                    ]
                    ()
        ]



-- THE REVEAL


revealing : Test
revealing =
    let
        after name =
            afterBody (reveal name)

        afterBody body =
            let
                model =
                    page { hasNext = False } "move"

                ( path, _ ) =
                    aTurn model
            in
            model |> step (BoardOut (Puzzle.Stepped path)) |> revealed body
    in
    describe "the reveal"
        [ test "a dubious play is a miss, named by its band: the verdict, the words, the candidates with yours marked" <|
            \_ ->
                rendered (after "move_dubious")
                    |> Expect.all
                        [ \q -> q |> Query.find [ id "pz-verdict" ] |> Query.has [ attribute (Html.Attributes.attribute "data-verdict" "fail"), attribute (Html.Attributes.attribute "data-band" "doubtful"), text "?! DUBIOUS" ]
                        , \q -> q |> Query.find [ id "pz-verdict" ] |> Query.find [ class "pz-verdict-word" ] |> Query.has [ class "g-doubtful" ]
                        , \q -> q |> Query.find [ id "pz-verdict" ] |> Query.has [ text "Gives up 0.07 — a dubious mistake." ]
                        , \q -> q |> Query.find [ id "pz-reveal" ] |> Query.has [ text "You played a dubious move." ]
                        , \q -> q |> Query.findAll [ class "rp-cand" ] |> Query.count (Expect.equal 3)
                        , \q -> q |> Query.findAll [ class "rp-cand", attribute (Html.Attributes.attribute "data-yours" "true") ] |> Query.count (Expect.equal 1)
                        , \q -> q |> Query.find [ class "rp-cand", attribute (Html.Attributes.attribute "data-yours" "true") ] |> Query.has [ attribute (Html.Attributes.attribute "data-rank" "2"), text "you" ]
                        , hasNot [ id "bg-action-play" ]
                        , hasNot [ id "bg-action-undo" ]
                        , has [ id "pz-share" ]
                        , hasNot [ id "pz-level" ]
                        ]
        , test "after the reveal, OPEN IN ANALYSIS beside SHARE opens this puzzle on the analysis board in a new tab" <|
            \_ ->
                rendered (after "move_dubious")
                    |> Query.find [ id "pz-analysis" ]
                    |> Query.has
                        [ tag "a"
                        , attribute (Html.Attributes.href (Route.href (Route.analysisPuzzle "fixmove1")))
                        , attribute (Html.Attributes.href "/analysis?p=fixmove1")
                        , attribute (Html.Attributes.target "_blank")
                        , attribute (Html.Attributes.rel "noopener")
                        , text "ANALYSIS"
                        ]
        , test "after the reveal, SAVE beside SHARE opens the save sheet for this puzzle" <|
            \_ ->
                Expect.all
                    [ \_ -> rendered (after "move_dubious") |> Query.find [ id "pz-save" ] |> Query.has [ tag "button", text "SAVE" ]
                    , \_ -> rendered (after "move_dubious") |> Query.find [ id "pz-save" ] |> Event.simulate Event.click |> Event.expect PressedSave
                    , \_ -> rendered (after "move_dubious") |> Query.hasNot [ id "save-modal" ]
                    , \_ -> (step PressedSave (after "move_dubious")).save |> Maybe.map .puzzleId |> Expect.equal (Just "fixmove1")
                    , \_ -> rendered (step PressedSave (after "move_dubious")) |> Query.find [ id "save-modal" ] |> Query.has [ text "SAVE TO A SET" ]
                    , \_ -> (step PressedSave (after "move_dubious")).save |> Maybe.andThen .signIn |> Maybe.map .next |> Expect.equal (Just "/puzzles/fix")
                    ]
                    ()
        , test "before the reveal there is no SAVE" <|
            \_ ->
                rendered (page { hasNext = False } "move") |> Query.hasNot [ id "pz-save" ]
        , test "a pass and a miss wear their colours" <|
            \_ ->
                Expect.all
                    [ \_ -> rendered (after "move_pass") |> Query.find [ id "pz-verdict" ] |> Query.has [ class "is-pass", text "RIGHT", text "That is the play." ]
                    , \_ -> rendered (after "move_fail") |> Query.find [ id "pz-verdict" ] |> Query.has [ class "is-fail", attribute (Html.Attributes.attribute "data-band" "bad"), text "? BAD", text "Gives up 0.14 — a bad mistake." ]
                    , \_ ->
                        rendered (afterBody (String.replace "\"cost\":0.14" "\"cost\":0.4" (String.replace "\"band\":\"bad\"" "\"band\":\"very_bad\"" (reveal "move_fail"))))
                            |> Query.find [ id "pz-verdict" ]
                            |> Query.has [ attribute (Html.Attributes.attribute "data-band" "very_bad"), text "?? VERY BAD", text "Gives up 0.40 — a very bad mistake." ]
                    ]
                    ()
        , test "a miss on the player's schedule says it comes back" <|
            \_ ->
                afterBody (revealWith "move_dubious" "schedule_amendable")
                    |> rendered
                    |> Query.find [ id "pz-verdict" ]
                    |> Query.has [ text "?! DUBIOUS", text "Gives up 0.07 — a dubious mistake, so it comes back." ]
        , test "a take too close to call: right, and said to be either way" <|
            \_ ->
                page { hasNext = False } "take"
                    |> step (PickedBand 1)
                    |> revealed (reveal "take_close")
                    |> rendered
                    |> Expect.all
                        [ Query.find [ id "pz-verdict" ] >> Query.has [ attribute (Html.Attributes.attribute "data-verdict" "pass"), text "RIGHT", text "Too close to call: either answer is right." ]
                        , Query.find [ id "pz-reveal" ] >> Query.has [ text "Too close to call: passing gains just 0.010, so either is fine." ]
                        ]
        , test "a double too close to call reads the same whichever side was picked" <|
            \_ ->
                let
                    verdictOf name band =
                        page { hasNext = False } "double"
                            |> step (PickedBand band)
                            |> revealed (reveal name)
                            |> rendered
                            |> Query.find [ id "pz-verdict" ]
                in
                Expect.all
                    (List.concatMap
                        (\( name, band ) ->
                            [ \_ ->
                                verdictOf name band
                                    |> Query.has
                                        [ attribute (Html.Attributes.attribute "data-verdict" "pass")
                                        , attribute (Html.Attributes.attribute "data-band" "")
                                        , text "RIGHT"
                                        , text "Too close to call: either answer is right."
                                        ]
                            , \_ ->
                                page { hasNext = False } "double"
                                    |> step (PickedBand band)
                                    |> revealed (reveal name)
                                    |> rendered
                                    |> Query.find [ id "pz-reveal" ]
                                    |> Query.has [ text "Too close to call: doubling gains just 0.003, so either is fine. If doubled, Black takes." ]
                            ]
                        )
                        [ ( "double_close_yes", 1 ), ( "double_close_no", -1 ) ]
                    )
                    ()
        , test "an attempt stored as close before dubious became a miss still reads as one" <|
            \_ ->
                afterBody (String.replace "\"verdict\":\"fail\"" "\"verdict\":\"hold\"" (reveal "move_dubious"))
                    |> rendered
                    |> Query.find [ id "pz-verdict" ]
                    |> Query.has [ attribute (Html.Attributes.attribute "data-verdict" "hold"), text "CLOSE", text "Not far off the best." ]
        , test "unknown: the engine did not rank this one, the best move is named, nothing is marked yours" <|
            \_ ->
                rendered (after "move_unknown")
                    |> Expect.all
                        [ \q -> q |> Query.find [ id "pz-verdict" ] |> Query.has [ attribute (Html.Attributes.attribute "data-verdict" "unknown"), text "The engine did not rank this one." ]
                        , \q -> q |> Query.find [ id "pz-reveal" ] |> Query.has [ text "The best move here is play 1." ]
                        , hasNot [ class "rp-cand", attribute (Html.Attributes.attribute "data-yours" "true") ]
                        ]
        , test "a candidate goes on the board, and the move played comes back" <|
            \_ ->
                let
                    model =
                        after "move_dubious"

                    showing =
                        step (Show (Just 1)) model
                in
                Expect.all
                    [ \_ -> rendered showing |> Query.find [ id "pz-board" ] |> Query.has [ class "is-proposed" ]
                    , \_ -> rendered showing |> Query.find [ class "rp-cand", attribute (Html.Attributes.attribute "data-rank" "1") ] |> Query.has [ class "is-on" ]
                    , \_ -> rendered (step (Show Nothing) showing) |> Query.find [ id "pz-board" ] |> Query.hasNot [ class "is-proposed" ]
                    ]
                    ()
        , test "a candidate on the board is what the note is about" <|
            \_ ->
                let
                    model =
                        after "move_dubious"

                    showing =
                        step (Show (Just 1)) model
                in
                Expect.all
                    [ \_ -> rendered showing |> Query.find [ id "pz-reveal" ] |> Query.has [ text "is the best move." ]
                    , \_ -> rendered showing |> Query.find [ id "pz-reveal" ] |> Query.hasNot [ text "You played" ]
                    , \_ -> rendered showing |> hasNot [ id "pz-verdict" ]
                    , \_ -> rendered model |> Query.findAll [ id "pz-verdict" ] |> Query.count (Expect.equal 1)
                    , \_ -> rendered model |> Query.find [ id "pz-reveal" ] |> Query.has [ text "You played" ]
                    , \_ -> rendered model |> Query.find [ id "pz-candidates" ] |> Query.findAll [ class "rp-cand-grade" ] |> Query.count (Expect.atLeast 1)
                    ]
                    ()
        , test "the dice take the move back, and again bring it back" <|
            \_ ->
                let
                    model =
                        after "move_dubious"

                    before =
                        step ToggleBefore model
                in
                Expect.all
                    [ \_ -> rendered model |> Query.find [ id "pz-board" ] |> Query.has [ class "dice-played" ]
                    , \_ -> rendered model |> Query.findAll [ id "pz-dice-toggle" ] |> Query.count (Expect.equal 1)
                    , \_ -> rendered before |> Query.find [ id "pz-board" ] |> Query.hasNot [ class "dice-played" ]
                    , \_ -> rendered (step ToggleBefore before) |> Query.find [ id "pz-board" ] |> Query.has [ class "dice-played" ]

                    -- a candidate on the board puts the move back first
                    , \_ -> rendered (step (Show (Just 1)) before) |> Query.find [ id "pz-board" ] |> Query.has [ class "is-proposed", class "dice-played" ]
                    ]
                    ()
        , test "the board no longer answers once the answer is in" <|
            \_ ->
                let
                    model =
                        after "move_dubious"
                in
                (step (BoardOut Puzzle.Undo) model).path |> Expect.equal model.path
        ]



-- THE CUBE


cube : Test
cube =
    describe "a cube question"
        [ test "the two answers, as at the table, in the side's words" <|
            \_ ->
                Expect.all
                    [ \_ ->
                        rendered (page { hasNext = False } "double")
