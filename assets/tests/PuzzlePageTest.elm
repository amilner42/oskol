                    , \_ -> rows (step (PressedOutcome "never") model) (Expect.equal 4)
                    , \_ -> rows (step (PressedOutcome "knew_it") model |> step (GotOutcome "knew_it" (Err Api.NetworkError))) (Expect.equal 4)
