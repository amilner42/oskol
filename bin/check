#!/usr/bin/env bash
# Every suite, in order, one command. Stops at the first failure.
#
#   bin/check --changed  only the suites your diff touches, against
#                        origin/main plus the working tree. An Elm-only
#                        change is about a second; a lib/ change is the
#                        Elixir suite and nothing else. What you run while
#                        you work.
#   bin/check            compile, Gleam tests, Elm typecheck + tests, Elixir
#                        tests -- without the handful tagged `slow` (whole
#                        matches played out, clocks that must run out in real
#                        time)
#   bin/check --all      the same, with the slow tests and a clean production
#                        release/source-set assertion. What you run before you
#                        push.
#   bin/check --browser  --all, then the Playwright smokes against a server
#                        this script starts and stops (on PORT, 4400 by
#                        default -- give it another when 4400 is taken)
#
# The Elixir suite runs through bin/test-par: four partitions, four databases,
# four VMs. It is the biggest thing here (48s serial, 20s partitioned), which
# is why even the full check is now about forty seconds.
#
# CI runs everything regardless, and catches what a local pass structurally
# cannot: the advisory audits, whose answer changes without your code
# changing, and a build on a machine that is not yours.
#
# Elm tests read a generated fixture corpus, so it is regenerated first
# (the committed golden replays are left alone; the Gleam suite guards them).
set -euo pipefail
cd "$(dirname "$0")/.."

step() { printf '\n\033[1m== %s\033[0m\n' "$1"; }
skip() { printf '\033[2m-- %s\033[0m\n' "$1"; }

mode="${1:-}"

# Which suites this run owes. Everything, unless --changed narrows it.
gleam=1
elm=1
elixir=1

if [[ "$mode" == "--changed" ]]; then
  # Against the branch point, plus whatever is still in the working tree --
  # the question is "what have I changed", not "what is committed".
  base="$(git merge-base HEAD origin/main 2>/dev/null \
       || git merge-base HEAD main 2>/dev/null \
       || git rev-parse HEAD)"
  changed="$( { git diff --name-only "$base"
                git diff --name-only
                git ls-files --others --exclude-standard; } | sort -u )"

  gleam=0
  elm=0
  elixir=0

  # Gleam compiles into the Elixir app, so touching src/ owes both suites.
  # The reverse is not true: lib/ cannot change what a Gleam test sees.
  if grep -qE '^(src/|test/.*\.gleam$|gleam\.toml$|manifest\.toml$)' <<<"$changed"; then
    gleam=1
    elixir=1
  fi
  if grep -qE '^assets/' <<<"$changed"; then
    elm=1
  fi
  # config/ and the lockfile decide what the suite runs against, so they count
  # as Elixir even when no .ex file moved -- a lockfile line is what turned
  # the advisory audit red on 2026-09-29.
  if grep -qE '^(lib/|test_support/|priv/|config/|test/.*\.exs$|mix\.exs$|mix\.lock$)' <<<"$changed"; then
    elixir=1
  fi

  if [[ -z "$changed" ]]; then
    skip "nothing changed against $(git rev-parse --short "$base")"
  elif (( ! gleam && ! elm && ! elixir )); then
    skip "no suite owns these files; compile and formatting only"
  fi
fi

step "mix compile"
mix compile

step "mix format (CI checks it; catch it here first)"
mix format --check-formatted
gleam format --check src test

if (( gleam )); then
  step "Gleam unit, rules, property and golden tests"
  bin/test-gleam
else
  skip "Gleam suite (no src/ or *.gleam change)"
fi

if (( elm )); then
  step "fixture payloads for elm-test"
  mix oskol.fixtures payloads >/dev/null

  step "Elm typecheck"
  (cd assets && ../node_modules/.bin/elm make src/Main.elm --output=/dev/null)

  step "Elm tests"
  (cd assets && ../node_modules/.bin/elm-test --compiler ../node_modules/.bin/elm)
else
  skip "Elm typecheck and tests (no assets/ change)"
fi

if (( elixir )); then
  step "Elixir tests"
  # bin/test-par creates and migrates each partition's database itself.
  if [[ "$mode" == "--all" || "$mode" == "--browser" ]]; then
    bin/test-par 4 --include slow
  else
    bin/test-par 4
  fi
else
  skip "Elixir suite (no lib/, test/, config/ or mix change)"
fi

if [[ "$mode" == "--all" || "$mode" == "--browser" ]]; then
  step "production release source set"
  bin/check-prod-release
fi

if [[ "$mode" == "--browser" ]]; then
  step "dev database"
  mix ecto.create --quiet && mix ecto.migrate --quiet

  step "assets"
  mix assets.build >/dev/null

  port="${PORT:-4400}"
  export PORT="$port"
  # The smokes' server asks its engine at a stand-in on its own port (PORT +
  # 10000), which the analysis board's smoke starts (its setup.exs); for the
  # other smokes nothing is listening there, as on CI. No smoke spends real
  # engine time.
  export ANALYSIS_STUB_PORT="${ANALYSIS_STUB_PORT:-$((port + 10000))}"
  export ANALYSIS_URL="http://localhost:$ANALYSIS_STUB_PORT"

  step "server on $port"
  log="${TMPDIR:-/tmp}/oskol-check-server.log"
  # A new session so the whole process group can be killed; macOS has no
  # setsid, so fall back to killing the one process there.
  if command -v setsid >/dev/null; then
    setsid bash -c 'exec mix phx.server' >"$log" 2>&1 &
    server=$!
    trap 'kill -- -'"$server"' 2>/dev/null || true' EXIT
  else
    bash -c 'exec mix phx.server' >"$log" 2>&1 &
    server=$!
    trap 'kill '"$server"' 2>/dev/null || true' EXIT
  fi
  for _ in $(seq 1 90); do
    curl -sf -o /dev/null "http://localhost:$port/" && break
    sleep 1
  done
  curl -sf -o /dev/null "http://localhost:$port/" || { echo "server did not start; see $log"; exit 1; }

  step "browser smokes"
  # Playwright's own Chromium download is not always available (sandboxes);
  # the scripts accept a binary via PW_CHROMIUM, defaulting to a preinstalled
  # one under /opt/pw-browsers when there is one.
  if [[ -z "${PW_CHROMIUM:-}" ]]; then
    PW_CHROMIUM="$(ls -d /opt/pw-browsers/chromium-*/chrome-linux/chrome 2>/dev/null | head -1 || true)"
    export PW_CHROMIUM
  fi
  node playwright/test-spa-landing/test.js
  node playwright/test-backgammon-smoke/test.js
  node playwright/test-backgammon-board/test.js
  # A phone held sideways: the board fits the screen height exactly. It
  # arranges its own danced room too (as the dance smoke does).
  node playwright/test-backgammon-landscape/test.js
  # Arranges its own room (a seed that dances, replayed into the dev
  # database) and opens it, so it also covers rehydrating mid-dance.
  node playwright/test-backgammon-dance/test.js
  # A finished match played again, with its analysis stubbed in the browser;
  # it arranges its own room (setup.exs) the same way.
  node playwright/test-backgammon-replay/test.js
  node playwright/test-guest-prefill/test.js
  # The signed-in home at `/`: the bar, live games, the form, the practice
  # line and the recent list with its MORE. It arranges its own account
  # (setup.exs) and creates the live game in the browser.
  node playwright/test-home/test.js
  # Signing in by email, the mail read from /dev/last-login: the code, the
  # link, an owned seat nobody can claim, logging out.
  node playwright/test-accounts/test.js
  # A puzzle from a link: it arranges a game graded against a stubbed
  # engine (setup.exs, in its own VM), then a stranger, the opponent and
  # the signed-in player who made the mistake each play it.
  node playwright/test-puzzle/test.js
  # The practice home: PUZZLES on the menu, a stranger's TRY ONE, a guest's
  # and an account's counts and a run from PRACTICE.
  node playwright/test-puzzles-hub/test.js
  # PRACTICE THIS GAME'S N MISTAKES from the result cards: it arranges an
  # unlimited session and a single game (setup.exs), a guest runs one and
  # is asked to sign in, an account runs the other.
  node playwright/test-puzzles-cards/test.js
  # The analysis board: a position set up by mouse and by finger, every
  # setting in the strip, the id in and out, and nothing moving.
  node playwright/test-analysis/test.js
fi

step "all green"
