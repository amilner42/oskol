<%!-- Elm's Browser.application takes the body over on boot; this is what a
      visitor with no JavaScript is left with, and what the app replaces.
      `/` paints the loading screen the app starts on (`Ui.Loading`): the
      homes' bar with only the bird in it, and the loading bar. Same markup,
      so the first paint is the app's and nothing flashes or moves. --%>
<div
  id="elm-app"
  class={if assigns[:home], do: "paper min-h-screen-safe quiet", else: "paper min-h-screen-safe"}
>
  <div :if={assigns[:home]} id="boot-page">
    <div class="lh lh-top">
      <header class="lh-bar">
        <a href="/" class="lh-mark" aria-label="Oskol home">
          <svg
            viewBox="0 0 16 16"
            width="32"
            height="32"
            shape-rendering="crispEdges"
            aria-hidden="true"
          >
            <path
              fill="currentColor"
              d="M8 1h4v1h-4zM7 2h6v1h-6zM6 3h7v1h-7zM6 4h2v1h-2zM9 4h1v1h-1zM11 4h2v1h-2zM6 5h2v1h-2zM11 5h2v1h-2zM6 6h7v1h-7zM2 7h1v1h-1zM6 7h7v1h-7zM2 8h2v1h-2zM5 8h8v1h-8zM2 9h11v1h-11zM3 10h10v1h-10zM4 11h9v1h-9zM5 12h7v1h-7zM6 13h1v1h-1zM10 13h1v1h-1z"
            />
            <path fill="#fbf9f3" d="M8 4h1v1h-1zM10 4h1v1h-1zM8 5h3v1h-3z" />
            <path
              fill="#ffd93d"
              d="M13 4h2v1h-2zM13 5h3v1h-3zM6 14h1v1h-1zM10 14h1v1h-1zM5 15h2v1h-2zM9 15h2v1h-2z"
            />
          </svg>
        </a>
      </header>
    </div>
    <div class="boot" role="progressbar" aria-label="Loading">
      <div class="boot-track">
        <div class="boot-fill"></div>
      </div>
    </div>
  </div>
</div>
