<div class="min-h-screen flex items-center justify-center bg-white">
  <div class="text-center px-6 max-w-md w-full">
    <h1 class="text-5xl sm:text-6xl font-bold text-gray-900 mb-3">
      oskol.io
    </h1>

    <p class="text-gray-500 text-sm mb-12">
      A poker roguelike for two players
    </p>

    <form id="game-form" class="space-y-4">
      <input
        type="text"
        id="game-name"
        name="game_name"
        placeholder="Enter game name"
        class="w-full bg-white border border-gray-300 rounded-lg px-4 py-3 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent text-center"
        autocomplete="off"
        autofocus
      />

      <button
        type="submit"
        class="w-full px-8 py-4 rounded-lg font-semibold text-lg bg-gray-900 hover:bg-gray-800 text-white transition-all shadow-md hover:shadow-lg"
      >
        Create Game
      </button>
    </form>

    <p class="text-gray-400 text-xs mt-6">
      Share the game name with a friend to play together
    </p>
  </div>
</div>

<script>
  document.getElementById('game-form').addEventListener('submit', function(e) {
    e.preventDefault();
    const gameName = document.getElementById('game-name').value.trim();
    if (gameName) {
      window.location.href = '/g/' + encodeURIComponent(gameName);
    }
  });
</script>
