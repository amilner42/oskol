<style>
  @keyframes gradient-shift {
    0%, 100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  .animated-gradient {
    background: linear-gradient(
      135deg,
      oklch(20% 0.05 240),
      oklch(15% 0.08 265),
      oklch(18% 0.06 280),
      oklch(16% 0.07 240)
    );
    background-size: 400% 400%;
    animation: gradient-shift 15s ease infinite;
  }

  .glow-text {
    text-shadow: 0 0 40px oklch(65% 0.25 265 / 0.4),
                 0 0 80px oklch(65% 0.25 265 / 0.2);
  }

  .card-glow {
    box-shadow: 0 8px 32px oklch(65% 0.25 265 / 0.15),
                0 0 0 1px oklch(65% 0.25 265 / 0.1);
  }
</style>

<div class="min-h-screen flex items-center justify-center animated-gradient">
  <div class="text-center px-6 max-w-lg w-full">
    <div class="mb-8">
      <h1 class="text-6xl sm:text-7xl font-bold text-white mb-4 glow-text">
        oskol.io
      </h1>

      <p class="text-white/70 text-lg mb-2">
        Poker Meets Strategy
      </p>

      <p class="text-white/50 text-sm max-w-md mx-auto">
        Upgrade your hands, outsmart your opponent, and dominate in this tactical twist on classic poker
      </p>
    </div>

    <form id="game-form" class="space-y-4">
      <div class="backdrop-blur-xl bg-white/5 rounded-2xl p-6 card-glow">
        <input
          type="text"
          id="game-name"
          name="game_name"
          placeholder="Enter game name"
          class="w-full bg-white/10 border border-white/20 rounded-xl px-5 py-4 text-white placeholder-white/40 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary/50 focus:bg-white/15 text-center text-lg transition-all"
          autocomplete="off"
          autofocus
        />

        <button
          type="submit"
          class="w-full mt-4 px-8 py-4 rounded-xl font-semibold text-lg bg-gradient-to-r from-primary to-secondary hover:from-primary/90 hover:to-secondary/90 text-white transition-all shadow-lg hover:shadow-2xl hover:shadow-primary/20 hover:scale-[1.02] active:scale-[0.98]"
        >
          Create Game
        </button>
      </div>
    </form>

    <p class="text-white/30 text-xs mt-6">
      Share the game name with a friend to start playing
    </p>
  </div>
</div>

<script>
  document.getElementById('game-form').addEventListener('submit', function(e) {
    e.preventDefault();
    const gameName = document.getElementById('game-name').value.trim();
    if (gameName) {
      window.location.href = '/g/' + encodeURIComponent(gameName);
    }
  });
</script>
