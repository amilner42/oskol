<div class="min-h-screen flex items-center justify-center bg-base-100">
  <div class="text-center px-6 max-w-md w-full">
    <h1 class="text-5xl sm:text-6xl font-bold text-base-content mb-3">
      oskol.io
    </h1>

    <p class="text-base-content/60 text-sm mb-12">
      A tactical multiplayer poker game
    </p>

    <form id="game-form" class="space-y-4">
      <input
        type="text"
        id="game-name"
        name="game_name"
        placeholder="Enter game name"
        class="w-full bg-base-200 border border-base-300 rounded-lg px-4 py-3 text-base-content placeholder-base-content/40 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-center"
        autocomplete="off"
        autofocus
      />

      <button
        type="submit"
        class="w-full px-8 py-4 rounded-lg font-semibold text-lg bg-primary hover:bg-primary/90 text-primary-content transition-all shadow-lg hover:shadow-xl hover:scale-[1.02]"
      >
        Create Game
      </button>
    </form>

    <p class="text-base-content/40 text-xs mt-6">
      Share the game name with a friend to play together
    </p>
  </div>
</div>

<script>
  document.getElementById('game-form').addEventListener('submit', function(e) {
    e.preventDefault();
    const gameName = document.getElementById('game-name').value.trim();
    if (gameName) {
      window.location.href = '/g/' + encodeURIComponent(gameName);
    }
  });
</script>
