      <div class="mini-card red"><span class="rank">K</span><span class="suit">♦</span></div>
      <div class="mini-card black"><span class="rank">K</span><span class="suit">♣</span></div>
    </div>
  </div>
  
<!-- Battle 4: Four Jacks vs Flush - Four of a kind wins -->
  <div
    class="floating-battle drift-l"
    style="--row: 38%; --speed: 35s; --rot: 2deg; --y-wave: -14px; animation-delay: -5s;"
  >
