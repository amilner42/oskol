      <div class="mini-card black"><span class="rank">J</span><span class="suit">♠</span></div>
      <div class="mini-card red"><span class="rank">J</span><span class="suit">♥</span></div>
      <div class="mini-card black"><span class="rank">J</span><span class="suit">♣</span></div>
