<div class="min-h-screen flex items-center justify-center bg-base-100">
  <div class="text-center px-4">
    <h1 class="text-6xl font-bold mb-12">
      It is pronounced <span class="text-primary"><%= @pronunciation %></span>
    </h1>

    <div class="flex flex-col sm:flex-row gap-4 justify-center mt-16">
      <button
        class="btn btn-lg btn-outline btn-disabled opacity-50 cursor-not-allowed"
        disabled
      >
        How to Play
      </button>

      <a
        href={~p"/g/#{@game_id}"}
        class="btn btn-lg btn-primary"
      >
        New Game
      </a>
    </div>
  </div>
</div>
