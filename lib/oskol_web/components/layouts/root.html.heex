<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="theme-color" content="#f7f4ea" />
    <%!-- A room code is not a secret, but it is not something to hand to
          every site a player clicks through to either. --%>
    <meta name="referrer" content="no-referrer" />
    <%!-- The name this browser last played under, against the silent guest
          cookie: the create and join forms prefill it on the first paint. --%>
    <meta :if={assigns[:guest_name]} name="guest-name" content={@guest_name} />
    <%!-- What a mailed sign-in link's page boots with: the address it is for
          and where to go after, or that it has expired. Read once, by
          Page.Login; nothing here is a credential. --%>
    <meta :if={assigns[:login]} name="login" content={@login} />
    <meta :if={assigns[:no_index]} name="robots" content="noindex" />
    <.live_title suffix=" · Oskol">{head_title(assigns)}</.live_title>
    <meta
      name="description"
      content={
        assigns[:meta_description] ||
          "Free two-player games, no account needed. Pick a game, share the invite link, and your friend is in within seconds."
      }
    />
    <%= if assigns[:canonical] do %>
      <link rel="canonical" href={@canonical} />
      <meta property="og:url" content={@canonical} />
    <% end %>
    <meta property="og:title" content={assigns[:og_title] || assigns[:page_title] || "Oskol"} />
    <meta
      property="og:description"
      content={
        assigns[:og_description] || assigns[:meta_description] ||
          "Two-player games you can start in one click"
      }
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Oskol" />
    <.share_card image={assigns[:puzzle_image]} />
    <meta name="twitter:title" content={assigns[:og_title] || assigns[:page_title] || "Oskol"} />
    <meta
      name="twitter:description"
      content={
        assigns[:og_description] || assigns[:meta_description] ||
          "Two-player games you can start in one click"
      }
    />
    <%= if assigns[:json_ld] do %>
      <script type="application/ld+json">
        <%= Phoenix.HTML.raw(@json_ld) %>
      </script>
    <% end %>

    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
